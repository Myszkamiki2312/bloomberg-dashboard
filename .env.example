# === BLOOMBERG DASHBOARD — ZMIENNE ŚRODOWISKOWE ===
# Skopiuj ten plik jako .env.local i uzupełnij klucze.
# Bez kluczy API aplikacja działa w trybie DEMO z danymi mock.

# --- CoinGecko (krypto — ceny i wykresy) ---
# Bezpłatny klucz demo: https://www.coingecko.com/en/api
# Bez klucza: ~30 zapytań/min (działa, ale łatwiej przekroczyć limit)
COINGECKO_API_KEY=

# --- Finnhub (akcje — kursy i wykresy) ---
# Bezpłatny klucz: https://finnhub.io/register
# Limit: 60 zapytań/min na planie darmowym
# Bez klucza: akcje pobierane z Yahoo Finance (bez limitu klucza)
FINNHUB_KEY=

# --- Groq (panel AI — DARMOWY, ZALECANY) ---
# Rejestracja: https://console.groq.com
# Darmowy tier: 6000 zapytań/dzień, brak karty płatniczej
# Model: llama-3.1-8b-instant (szybki, obsługuje JSON mode)
GROQ_API_KEY=

# --- Anthropic (panel AI — alternatywa dla Groq) ---
# Rejestracja: https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- OpenAI (panel AI — alternatywa dla Groq/Anthropic) ---
# Rejestracja: https://platform.openai.com
OPENAI_API_KEY=

# --- Konfiguracja ogólna ---
# DEMO_MODE=true wymusza dane mock niezależnie od kluczy API
NEXT_PUBLIC_DEMO_MODE=false
