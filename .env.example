# === BLOOMBERG DASHBOARD — ZMIENNE ŚRODOWISKOWE ===
# Skopiuj ten plik jako .env.local i uzupełnij klucze.
# Bez kluczy API aplikacja działa w trybie DEMO z danymi mock.

# --- CoinGecko (krypto) ---
# Bezpłatny klucz demo: https://www.coingecko.com/en/api
# Bez klucza: 10-30 zapytań/min (działa, ale limit szybszy)
COINGECKO_API_KEY=

# --- Alpha Vantage (akcje) ---
# Bezpłatny klucz: https://www.alphavantage.co/support/#api-key
# Limit: 25 zapytań/dzień (plan darmowy)
ALPHA_VANTAGE_KEY=

# --- Finnhub (akcje, WebSocket realtime) ---
# Bezpłatny klucz: https://finnhub.io/register
# Limit: 60 zapytań/min, WebSocket dostępny
FINNHUB_KEY=

# --- NewsAPI (wiadomości) ---
# Bezpłatny klucz: https://newsapi.org/register
# Limit: 100 zapytań/dzień, tylko localhost (plan dev)
NEWS_API_KEY=

# --- Groq (panel AI — DARMOWY, ZALECANY) ---
# Rejestracja: https://console.groq.com
# Darmowy tier: 6000 zapytań/dzień, brak karty płatniczej
# Model: llama-3.1-8b-instant (szybki, polski)
GROQ_API_KEY=

# --- Anthropic (panel AI — alternatywa) ---
# Rejestracja: https://console.anthropic.com (~$5 kredytów na start)
ANTHROPIC_API_KEY=

# --- OpenAI (panel AI — alternatywa) ---
# Rejestracja: https://platform.openai.com (~$5 kredytów na start)
OPENAI_API_KEY=

# --- Konfiguracja ogólna ---
# DEMO_MODE=true wymusza dane mock niezależnie od kluczy
NEXT_PUBLIC_DEMO_MODE=false

# URL do samodzielnego deploymentu (opcjonalnie)
NEXT_PUBLIC_APP_URL=http://localhost:3000
